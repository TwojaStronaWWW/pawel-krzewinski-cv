#!/usr/bin/env bash
# Git Pre-commit Hook dla repozytorium pawel-krzewinski-cv (ISO 27001 / DevSecOps)
# Uruchamia blokadę wycieku sekretów, weryfikację składni oraz testy jednostkowe przed zatwierdzeniem zmian.

set -euo pipefail

echo "🔍 [pre-commit] Uruchamianie lokalnej bramy jakościowej i bezpieczeństwa (Quality & Secret Gate)..."

# 1. Blokada przypadkowego commitowania plików z wrażliwymi sekretami (.env*, klucze, bazy, skany RODO)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$STAGED_FILES" ]; then
  FORBIDDEN_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -vE '(^|/)\.env\.example$' | grep -iE '(^|/)\.env($|\.|_)|\.env\.bak|\.(pem|key|pfx|p12|kdbx|sqlite[0-9]*)$|token.*\.json$|credentials.*\.json$|config/secrets\.php$|\.htpasswd$|^source-scans/|^docs/audits/' || true)
  if [ -n "$FORBIDDEN_FILES" ]; then
    echo "❌ BŁĄD BEZPIECZEŃSTWA: Wykryto chroniony plik z sekretami lub danymi RODO w indeksie Git:"
    echo "$FORBIDDEN_FILES"
    echo "Usuń plik z indeksu poleceniem: git reset HEAD <plik>"
    exit 1
  fi
fi

# 2. Skanowanie treści zmian pod kątem wycieku kluczy API, tokenów i kluczy prywatnych
ADDED_LINES=$(git diff --cached -U0 -- . ':(exclude)tests/**' ':(exclude).gitleaks.toml' ':(exclude).githooks/pre-commit' | grep -E '^\+[^+]' || true)
if [ -n "$ADDED_LINES" ]; then
  if printf '%s\n' "$ADDED_LINES" | grep -E '(BEGIN [A-Z0-9 ]*PRIVATE KEY|AIza[0-9A-Za-z_-]{35}|sk-ant-[0-9A-Za-z_-]{20,}|gh[pousr]_[0-9A-Za-z]{30,}|gsk_[0-9A-Za-z]{20,})' >/dev/null; then
    echo "❌ BŁĄD BEZPIECZEŃSTWA: Wykryto surowy klucz prywatny lub token API w treści commita!"
    exit 1
  fi
fi

# 3. Opcjonalny skan Gitleaks (jeśli zainstalowany w systemie)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml
fi

# 4. Uruchomienie pełnego zestawu testów i walidacji składni
npm run check

echo "✅ [pre-commit] Wszystkie testy i kontrole bezpieczeństwa przeszły pomyślnie! Zezwolono na commit."
