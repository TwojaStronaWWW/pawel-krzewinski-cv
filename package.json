{
  "name": "pawel-krzewinski-cv",
  "version": "1.0.0",
  "description": "Oficjalne interaktywne CV i generator PDF A4 Pawła Krzewińskiego – Specjalista ds. Dystrybucji Wydawniczej, Księgarni, Logistyki i Systemów ERP",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TwojaStronaWWW/pawel-krzewinski-cv.git"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js",
    "build:pdf": "node scripts/generate-pdf.js",
    "serve": "node scripts/serve.js",
    "dev": "node scripts/serve.js",
    "check:syntax": "node --check assets/js/main.js && node --check scripts/serve.js && node --check scripts/generate-pdf.js",
    "check": "npm run check:syntax && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "cv",
    "pawel-krzewinski",
    "logistyka",
    "gospodarka-magazynowa",
    "wydawnictwo",
    "ksiegarnia",
    "erp",
    "impuls-evo",
    "subiekt"
  ],
  "author": "Paweł Krzewiński",
  "license": "UNLICENSED"
}
