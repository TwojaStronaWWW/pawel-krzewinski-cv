# ==============================================================================
# [REF-01] Evergreen Web Standards & Static Threat Protection (.htaccess)
# Repozytorium: TwojaStronaWWW/pawel-krzewinski-cv (https://pawelkrzewinski.pl)
# Standard: ISO/IEC 27001:2023, OWASP ASVS, h5bp/server-configs-apache
# ==============================================================================

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 1. Typy MIME ([REF-01], [REF-07])
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif                                  .avif
  AddType image/webp                                  .webp
  AddType image/svg+xml                               .svg
  AddType font/woff2                                  .woff2
  AddType application/manifest+json                   .webmanifest
  AddType application/ld+json                         .jsonld
  AddType text/markdown                               .md
  AddCharset UTF-8 .html .css .js .json .webmanifest .xml .txt .md
</IfModule>

# ------------------------------------------------------------------------------
# 2. Rewrite Engine: HTTPS, Kanoniczny non-www ([REF-08]), PHP2Shell & Dotfiles
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 2.1 PHP2Shell / CGI Argument Injection / Stream Wrapper / Path Traversal Guard
  RewriteCond %{QUERY_STRING} (?:^|&)(?:auto_prepend_file|auto_append_file|allow_url_include|allow_url_fopen) [NC,OR]
  RewriteCond %{QUERY_STRING} (?:%2d|-d\s*allow_url|php://|data://|expect://|input://|phar://|zip://) [NC,OR]
  RewriteCond %{QUERY_STRING} (?:\.\./|\.\.\\|%2e%2e|%00|<script|base64_encode|GLOBALS|_REQUEST) [NC]
  RewriteRule ^ - [F,L]

  # 2.2 Blokada ukrytych katalogów i plików z kropką (z wyjątkiem /.well-known/ RFC 9116)
  RewriteRule ^(?!\.well-known/)(?:.*/)?\.[^/]+(?:/|$) - [F,L]

  # 2.3 Blokada katalogów roboczych, testowych i skanów źródłowych RODO
  RewriteRule ^(?:source-scans|tests|scripts|node_modules|docs)(?:/|$) - [F,L]

  # 2.4 Przekierowanie 301: wymuszenie HTTPS oraz domeny kanonicznej bez www ([REF-08])
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Blokada plików wrażliwych, sekretów, baz danych i skryptów serwerowych
# ------------------------------------------------------------------------------
<FilesMatch "(?i)(^\.env|^\.git|^\.htaccess|^\.htpasswd|^\.npmrc|^\.gitleaks\.toml|^\.lighthouserc\.json|^\.editorconfig|^\.gitattributes|^package(-lock)?\.json$|^composer\.(json|lock)$|^(AGENTS|GEMINI|README|SECURITY)\.md$|\.(pem|key|pfx|p12|kdbx|sqlite[0-9]*|db|sql|bak|old|orig|tmp|swp|log|sh|yml|yaml|toml|ini|conf|php[0-9]*|phtml|phar|cgi|pl|py))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. Nagłówki Bezpieczeństwa HTTP ([REF-01] Mozilla Observatory / OWASP)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# 5. Kompresja Brotli + Gzip/Deflate ([REF-01])
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/markdown text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Polityka Cache dla zasobów statycznych
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                                      "access plus 1 hour"
  ExpiresByType text/html                             "access plus 0 seconds"
  ExpiresByType text/markdown                         "access plus 1 hour"
  ExpiresByType text/plain                            "access plus 1 hour"
  ExpiresByType application/manifest+json             "access plus 1 week"
  ExpiresByType text/css                              "access plus 1 month"
  ExpiresByType text/javascript                       "access plus 1 month"
  ExpiresByType application/javascript                "access plus 1 month"
  ExpiresByType image/avif                            "access plus 6 months"
  ExpiresByType image/webp                            "access plus 6 months"
  ExpiresByType image/png                             "access plus 6 months"
  ExpiresByType image/jpeg                            "access plus 6 months"
  ExpiresByType image/svg+xml                         "access plus 6 months"
  ExpiresByType font/woff2                            "access plus 1 year"
</IfModule>
